{
  "compilerOptions": {
    "moduleResolution": "Node16",
    "module": "Node16",
    "allowJs": true,
    "esModuleInterop": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "lib": ["es2023", "WebWorker"],
    "strict": false,
    "declaration": true,
    "resolveJsonModule": true
  },

  "include": ["src/**/*.js", "src/**/*.json", "src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.js"],
}
